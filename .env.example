# Application Environment
ENV=production
DEBUG=False
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here

# S3 Configuration
S3_BUCKET_NAME=personal-library-pdfs
S3_UPLOAD_PREFIX=uploads/

# SQS Configuration
SQS_INDEXING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/indexing-queue
SQS_QUEUE_NAME=indexing-queue

# ChromaDB Configuration
CHROMADB_HOST=chromadb.internal
CHROMADB_PORT=8000
CHROMADB_HTTP_CLIENT_URL=http://chromadb.internal:8000

# Bedrock Configuration
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# RAG Configuration
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_LENGTH=4000

# API Configuration
API_PREFIX=/api
API_TIMEOUT_SECONDS=30

# Indexer Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIES=3
VISIBILITY_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
